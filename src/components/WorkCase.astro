---
import BookAcknowledgement from './BookAcknowledgement.astro';import PublishedArtifacts from './PublishedArtifacts.astro';import Layout from '../layouts/Layout.astro';import SiteNav from './SiteNav.astro';import SiteFooter from './SiteFooter.astro';import D from '../../data/source.js';
const P=D.presence;const {id}=Astro.props;const p=P.projects.find(p=>p.id===id);const claims=P.claims.filter(c=>p.claimIds.includes(c.id));
---
<Layout title={`${p.name} — ${p.hook} | Mario Marcolongo`} description={p.text}><SiteNav/><main id="main-content" class="presence-shell case-shell"><p><a href="/work">Selected work</a></p><p class="meta">{p.status}</p><h1>{p.hook}</h1><p class="lede">{p.text}</p><div class="source-links">{p.links.map(l=><a href={l.url}>{l.label}</a>)}</div>{id==='entropy'&&<BookAcknowledgement/>}<PublishedArtifacts id={id}/>{p.image&&!['entropy','atlas','notandia','yourself-to-science','hypermandala'].includes(id)&&<figure><a href={p.image}><img src={p.image} alt={p.alt} width="800" height="450"/></a><figcaption>{p.name} · public artifact; source links above.</figcaption></figure>}{p.sections.map(s=><section><h2>{s.heading}</h2><p>{s.text}</p></section>)}{id==='ai-evaluation'&&<p><a class="button" href="/cv-ai">AI evaluation résumé</a></p>}{id==='notandia'&&<p><a href="https://github.com/notandia/zotero-plugin">Separate Zotero source repository</a></p>}{claims.length>0&&<section><h2>Claim provenance</h2>{claims.map(c=><details><summary>{c.text}</summary><p>{c.limitation}</p><p class="meta">Evidence: {c.evidenceType.replaceAll('_',' ')} · Owner: {c.sourceOwner.replaceAll('_',' ')} · Observed {c.observedAt}{c.startDate&&` · Event/start ${c.startDate}`}.</p>{c.sourceUrl ? <a href={c.sourceUrl}>Original evidence</a> : <p>{c.sourceNote}</p>}</details>)}</section>}<p class="evidence-note">Source review: {p.reviewedAt || P.reviewedAt}. This is a dated account; the linked sources may have changed.</p></main><SiteFooter/></Layout>
