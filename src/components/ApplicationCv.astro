---
import Layout from '../layouts/Layout.astro';import SiteNav from './SiteNav.astro';import SiteFooter from './SiteFooter.astro';import D from '../../data/source.js';
const P=D.presence;const {variant='default'}=Astro.props;const cv=P.cv[variant];
const entry=(name,meta,bullets,url)=>({name,meta,bullets,url});
const entropy={...entry('Entropy for Life','Scientific research, fact-checking & website operations · Paid contractor · Jun 2023–Present',[P.cvBullets.entropy[0],P.cvBullets.entropy[variant==='technical'?2:1]],'/work/entropy'),context:P.entropyOrganization.cvContext};
const atlas=entry('AI Safety Formalization Atlas','Open-source contributor · Sep 2026',P.cvBullets.atlas,'/work/atlas');
const yts=entry('Yourself to Science','Founder · Independent project',[P.cvBullets.yts[0]],'/work/yourself-to-science');
const notandia=entry('Notandia','Independent project · AI-assisted implementation',P.cvBullets.notandia,'/notandia');
const gray=entry('Gray Swan',`Independent evaluation · ${P.aiEvaluationSnapshot.displayDate}`,P.cvBullets.gray,P.aiEvaluationSnapshot.evidencePath);
const wiki=entry('Wikipedia, Wikidata & Wikimedia Commons','Public contributor · Since 2018',[P.cvBullets.wikimedia[0]],'/work/wikimedia');
const padua=entry('University of Padua research project','Volunteer collaboration · 2022–2025',P.cvBullets.padua,'/research-operations');
const sections=variant==='default'?[{title:'Experience',entries:[entropy,padua]},{title:'Independent work & public contributions',entries:[atlas,wiki,yts]}]:variant==='technical'?[{title:'Professional experience',entries:[entropy]},{title:'Technical & data contributions',entries:[notandia,atlas,wiki]}]:[{title:'Independent evaluation work',entries:[gray]},{title:'Professional & research experience',entries:[entropy,padua]},{title:'Public-source contributions',entries:[atlas,wiki]}];

---
<Layout title={`Mario Marcolongo — ${cv.title}`} description={`${cv.summary} One-page application résumé with contact details, experience, education and source links.`}><SiteNav/><main id="main-content" class="presence-shell">
<nav class="resume-switch" aria-label="Résumé versions"><div class="resume-choices"><a href="/cv" aria-current={variant==='default'?'page':undefined}><strong>Research operations</strong><span>Scientific work &amp; sources</span></a><a href="/cv-technical" aria-current={variant==='technical'?'page':undefined}><strong>Technical operations</strong><span>Tools &amp; troubleshooting</span></a><a href="/cv-ai" aria-current={variant==='aiEvaluation'?'page':undefined}><strong>AI evaluation</strong><span>Model testing &amp; research</span></a></div><a class="button primary" href={`/${cv.filename}`} download>Download PDF</a><button type="button" onclick="window.print()">Print résumé</button></nav>
<article class="resume-document" id="cvDocument" data-ats-layout="single-column">
<header><h1>{P.name}</h1><p class="resume-title">{cv.title}</p><p class="meta" id="resume-location">Italy · EU citizen · Open to international remote work & relocation</p><p class="meta"><a href={`mailto:${P.email}`}>{P.email}</a><span id="cvPhoneSlot" hidden></span> · <a href={P.canonicalUrl}>mariomarcolongo.com</a> · <a href={P.linkedin}>LinkedIn</a> · <a href={P.orcidUrl}>ORCID</a>{variant!=='default'&&<> · <a href={P.github}>GitHub</a></>}</p></header>
<section><h2>Summary</h2><p>{cv.summary}</p></section>
{sections.map(section=><section><h2>{section.title}</h2>{section.entries.map(e=><div class="resume-entry"><h3>{e.name}</h3><p class="meta">{e.meta} · <a href={`${P.canonicalUrl}${e.url}`}>View work</a></p>{e.context&&<p class="meta">{e.context}</p>}<ul>{e.bullets.map(b=><li>{b}</li>)}</ul></div>)}</section>)}
<section><h2>Education</h2>{P.education.slice(0,variant==='technical'?1:2).map(e=><div class="resume-entry"><h3>{e.institution} — {e.title}</h3><p class="meta">{e.period}</p>{(e.cvDescription??e.description)&&<p>{e.cvDescription??e.description}</p>}</div>)}</section>
<section><h2>Skills</h2><p><strong>Demonstrated work:</strong> {variant==='technical'?'WordPress, hosting, DNS/SSL, requirements, functional testing, release troubleshooting and technical documentation.':variant==='aiEvaluation'?'Adversarial model testing, scientific literature search, source verification and technical documentation.':'Scientific literature search, source verification, data visualization, WordPress and structured metadata.'} <strong>Current study:</strong> Python, SQL, systems and quantitative foundations.</p></section>
<section><h2>Languages</h2><p>{P.languages.text} · <a href={P.languages.sourceUrl}>Certificate</a></p></section>
<p class="evidence-note">Independent software projects use AI-assisted implementation. <a href="/experience">Full experience and source records</a>.</p>
</article></main><SiteFooter/></Layout>
