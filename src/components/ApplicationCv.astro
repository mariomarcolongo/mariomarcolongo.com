---
import Layout from '../layouts/Layout.astro';import SiteNav from './SiteNav.astro';import SiteFooter from './SiteFooter.astro';import D from '../../data/source.js';
const P=D.presence;const {variant='default'}=Astro.props;const cv=P.cv[variant];
const entry=(name,meta,bullets,url)=>({name,meta,bullets,url});
const entropy=entry('Entropy for Life','Paid contractor · Jun 2023–Present',[P.cvBullets.entropy[0],P.cvBullets.entropy[2]],'/work/entropy');
const atlas=entry('AI Safety Formalization Atlas','Open-source contributor · Sep 2026',P.cvBullets.atlas,'/work/atlas');
const yts=entry('Yourself to Science','Founder · Independent project',[P.cvBullets.yts[0]],'/work/yourself-to-science');
const notandia=entry('Notandia','Independent project · AI-assisted implementation',P.cvBullets.notandia,'/notandia');
const gray=entry('Gray Swan','Independent evaluation · July 2026 snapshot',P.cvBullets.gray,'/evidence/gray-swan-2026-07-29/');
const wiki=entry('Wikipedia, Wikidata & Wikimedia Commons','Public contributor · Since 2018',[P.cvBullets.wikimedia[0]],'/work/wikimedia');
const padua=entry('University of Padua research project','Volunteer collaboration · 2022–2025',P.cvBullets.padua,'/research-operations');
const sections=variant==='default'?[{title:'Experience',entries:[entropy,padua]},{title:'Independent work & public contributions',entries:[wiki,yts]}]:variant==='technical'?[{title:'Professional experience',entries:[entropy]},{title:'Technical & data contributions',entries:[notandia,atlas,wiki]}]:[{title:'Independent evaluation work',entries:[gray]},{title:'Professional & research experience',entries:[entropy,padua]},{title:'Public-source contributions',entries:[wiki]}];

---
<Layout title={`Mario Marcolongo — ${cv.title}`}><SiteNav/><main id="main-content" class="presence-shell">
<nav class="resume-switch" aria-label="Résumé versions"><p><a href="/cv">Research &amp; Technical Operations</a> · <a href="/cv-technical">Technical Operations</a> · <a href="/cv-ai">AI Evaluation &amp; Research Support</a></p><a class="button primary" href={`/${cv.filename}`} download>Download PDF</a> <button type="button" onclick="window.print()">Print résumé</button></nav>
<article class="resume-document" id="cvDocument" data-ats-layout="single-column">
<header><h1>{P.name}</h1><p class="resume-title">{cv.title}</p><p class="meta" id="resume-location">Italy · EU citizen · Seeking relocation abroad</p><p class="meta"><a href={`mailto:${P.email}`}>{P.email}</a><span id="cvPhoneSlot" hidden></span> · <a href={P.canonicalUrl}>mariomarcolongo.com</a> · <a href={P.linkedin}>LinkedIn</a>{variant!=='default'&&<> · <a href={P.github}>GitHub</a></>}</p></header>
<section><h2>Summary</h2><p>{cv.summary}</p></section>
{sections.map(section=><section><h2>{section.title}</h2>{section.entries.map(e=><div class="resume-entry"><h3>{e.name}</h3><p class="meta">{e.meta} · <a href={`${P.canonicalUrl}${e.url}`}>View work</a></p><ul>{e.bullets.map(b=><li>{b}</li>)}</ul></div>)}</section>)}
<section><h2>Education</h2>{P.education.slice(0,variant==='technical'?1:2).map(e=><div class="resume-entry"><h3>{e.institution} — {e.title}</h3><p class="meta">{e.period}</p>{e.description&&<p>{e.description}</p>}</div>)}</section>
<section><h2>Skills</h2><p><strong>Demonstrated work:</strong> {variant==='technical'?'Requirements definition, functional testing, release troubleshooting and technical documentation.':variant==='aiEvaluation'?'Evidence documentation, model-behavior testing on the demonstrated platform surfaces, scientific source investigation and technical documentation.':'Scientific literature search, source verification, information organization, technical documentation and functional testing.'}</p><p><strong>Programming foundations:</strong> {P.cvSkills.foundation} {P.cvSkills.currentStudy}</p></section>
<section><h2>Languages</h2><p>{P.languages.text} · <a href={P.languages.sourceUrl}>Certificate</a></p></section>
<p class="evidence-note">Technical project implementation is AI-assisted; contributions and source records are linked above.</p>
</article></main><SiteFooter/></Layout>
