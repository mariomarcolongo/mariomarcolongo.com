---
import EmailLink from './EmailLink.astro';
import InlineEvidence from './InlineEvidence.astro';
import Layout from '../layouts/Layout.astro';import SiteNav from './SiteNav.astro';import SiteFooter from './SiteFooter.astro';import D from '../../data/source.js';
const P=D.presence;const {variant='default'}=Astro.props;const cv=P.cv[variant];
const entry=(key,name,meta,bullets,url)=>({key,name,meta:P.cvMeta?.[key]??meta,bullets,url,evidence:P.cvEvidence?.[key]??[]});
const entropyIndexes=variant==='technical'?[3,2]:variant==='aiEvaluation'?[1,3]:[0,1];
const entropy={...entry('entropy','Entropy for Life','Scientific research, fact-checking & website operations · Paid contractor · Jun 2023–Present',entropyIndexes.map(index=>P.cvBullets.entropy[index]).filter(Boolean),'/work/entropy'),context:P.entropyOrganization.cvContext};
entropy.meta=`${variant==='technical'?'Website operations & AI workflows':'Scientific content & technical operations'} · ${entropy.meta}`;
const atlas=entry('atlas','AI Safety Formalization Atlas','Open-source contributor · Sep 2026',P.cvBullets.atlas,'/work/atlas');
const yts=entry('yts','Yourself to Science','Founder · Independent project',[P.cvBullets.yts[0]],'/work/yourself-to-science');
const notandia=entry('notandia','Notandia','Independent project · AI-assisted implementation',P.cvBullets.notandia,'/notandia');
const gray=entry('gray','Gray Swan',`Independent evaluation · ${P.aiEvaluationLatestSnapshot.displayDate} record`,P.cvBullets.gray,'/ai-evaluation');
const wiki=entry('wikimedia','Wikipedia, Wikidata & Wikimedia Commons','Public contributor · Since 2018',[P.cvBullets.wikimedia[0]],'/work/wikimedia');
const padua=entry('padua','University of Padua research project','Volunteer collaboration · 2022–2025',P.cvBullets.padua,'/research-operations');
const sections=variant==='default'?[{title:'Experience',entries:[entropy,padua]},{title:'Independent work & public contributions',entries:[atlas,wiki,yts]}]:variant==='technical'?[{title:'Professional experience',entries:[entropy]},{title:'Technical & data contributions',entries:[notandia,atlas,wiki]}]:[{title:'Independent evaluation work',entries:[gray]},{title:'Professional & research experience',entries:[entropy,padua]},{title:'Public-source contributions',entries:[atlas,wiki]}];
const demonstratedWork=P.cvSkills.demonstrated?.[variant]??(variant==='technical'?'WordPress, hosting, DNS/SSL, requirements, functional testing, release troubleshooting and technical documentation.':variant==='aiEvaluation'?'Adversarial model testing, scientific literature search, source verification and technical documentation.':'Scientific literature search, source verification, data visualization, WordPress and structured metadata.');

---
<Layout title={`Mario Marcolongo — ${cv.title}`} description={`${cv.summary} One-page application résumé with contact details, experience, education and source links.`}><SiteNav/><main id="main-content" class="presence-shell">
<nav class="resume-switch" aria-label="Résumé versions"><div class="resume-choices"><a href="/cv" aria-current={variant==='default'?'page':undefined}><strong>Research operations</strong><span>Source quality &amp; coordination</span></a><a href="/cv-technical" aria-current={variant==='technical'?'page':undefined}><strong>AI workflows &amp; delivery</strong><span>Implementation &amp; software quality</span></a><a href="/cv-ai" aria-current={variant==='aiEvaluation'?'page':undefined}><strong>AI evaluation</strong><span>Model testing &amp; investigations</span></a></div><a class="button primary" href={`/${cv.filename}`} download>Download PDF</a><button type="button" onclick="window.print()">Print résumé</button></nav>
<article class="resume-document" id="cvDocument" data-ats-layout="single-column">
<header><h1>{P.name}</h1><p class="resume-title">{cv.title}</p><p class="meta" id="resume-location">Italy · EU citizen · Open to international remote work & relocation</p><p class="meta"><EmailLink>{P.email}</EmailLink><span id="cvPhoneSlot" hidden></span> · <a href={P.canonicalUrl}>mariomarcolongo.com</a> · <a href={P.linkedin}>LinkedIn</a> · <a href={P.orcidUrl}>ORCID</a> · <a href={P.github}>GitHub</a></p></header>
<section><h2>Summary</h2><p>{cv.summary}</p></section>
{sections.map(section=><section><h2>{section.title}</h2>{section.entries.map(e=><div class="resume-entry"><h3><a href={`${P.canonicalUrl}${e.url}`}>{e.name}</a></h3><p class="meta">{e.meta}</p>{e.context&&<p class="meta">{e.context}</p>}<ul>{e.bullets.map(b=><li><InlineEvidence text={b} links={e.evidence}/></li>)}</ul></div>)}</section>)}
<section><h2>Education &amp; credentials</h2>{P.education.slice(0,variant==='default'?2:1).map(e=><div class="resume-entry"><h3>{e.institution} — {e.cvTitle??e.title}</h3><p class="meta">{e.period}</p>{(e.cvDescription??e.description)&&<p><InlineEvidence text={e.cvDescription??e.description} links={e.sourceUrl?[{label:'Fully online degree-credit pathway',url:e.sourceUrl}]:[]}/></p>}</div>)}{P.credentials.map(c=><p><a href={c.url}><strong>{c.title}</strong></a> · Oct 2026</p>)}</section>
<section><h2>Skills</h2><p><strong>Demonstrated work:</strong> {demonstratedWork}</p>{variant!=='technical'&&<p><strong>Independent investigations:</strong> {P.investigationMethods.cvText}</p>}<p><strong>Current study:</strong> {P.cvSkills.currentStudy.replace(/^Continuing study in /,'')}</p></section>
<section><h2>Languages</h2><p>{P.languages.cvText} · <a href={P.languages.sourceUrl}>Certificate</a></p></section>
<p class="evidence-note">Independent software projects use AI-assisted implementation. <a href="/experience">Full experience and source records</a>.</p>
</article></main><SiteFooter/></Layout>
