---
import EmailLink from './EmailLink.astro';
import D from '../../data/source.js';
const P=D.presence;
---
<footer class="site-footer">
<p>Mario Marcolongo · <EmailLink>Email</EmailLink> · <a href={P.github}>GitHub</a> · <a href={P.linkedin}>LinkedIn</a> · <a href={P.orcidUrl}>ORCID</a></p>
<p><a href="/evidence">Evidence index</a> · <a href="/evidence#research-profiles-title">Research profiles</a> · <a href="/llms.txt">Text index</a> · <a href="/profile.json">Structured profile</a></p>
<details><summary>Short profile</summary><p id="short-profile">{P.machineSummary}</p><button id="copy-profile" type="button" hidden>Copy short profile</button><span id="copy-status" role="status" aria-live="polite"></span></details>
</footer>
<script>
const copy=document.querySelector<HTMLButtonElement>('#copy-profile');
if(copy){copy.hidden=false;copy.addEventListener('click',async()=>{const status=document.querySelector('#copy-status');try{await navigator.clipboard.writeText(document.querySelector('#short-profile')?.textContent||'');copy.textContent='Copied';if(status)status.textContent=' Profile copied.';setTimeout(()=>{copy.textContent='Copy short profile';if(status)status.textContent='';},2000);}catch{if(status)status.textContent=' Select and copy the profile text above.';}});}
</script>
