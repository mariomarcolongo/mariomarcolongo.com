---
import D from '../../data/source.js';
---
<section id="credentials" aria-labelledby="credentials-title">
  <h2 id="credentials-title">Assessed skills</h2>
  <div class="credential-list">{D.presence.credentials.map(c=><article>
    <p class="meta">{c.issuer} · Earned {c.displayDate}</p>
    <h3><a href={c.url}>{c.title} <span class="ext" aria-hidden="true">↗</span></a></h3>
    <p>{c.assessmentDescription}</p>
    <p class="meta">Credential ID: {c.credentialId}{c.expiryDisplayDate&&` · Valid through ${c.expiryDisplayDate}`}{c.relatedTraining&&` · ${c.relatedTraining.completedModules} related Microsoft Learn training modules completed.`}</p>
  </article>)}</div>
</section>
