---
import D from '../../data/source.js';
---
<section id="credentials" class="presence-section" aria-labelledby="credentials-title">
  <h2 id="credentials-title">Assessed skills</h2>
  {D.presence.credentials.map(c=><article>
    <p class="meta">{c.issuer} · Earned {c.displayDate}</p>
    <h3><a href={c.url}>{c.title} ↗</a></h3>
    <p>Passed an interactive hands-on lab assessment covering {c.scope.charAt(0).toLowerCase()+c.scope.slice(1)}</p>
    <p class="meta">Credential ID: {c.credentialId} · {c.relatedTraining.completedModules} related Microsoft Learn training modules completed.</p>
  </article>)}
</section>
