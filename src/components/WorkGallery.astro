---
import D from '../../data/source.js';
const ids=['entropy','scientific-visualizations','yourself-to-science'];
const items=ids.map(id=>D.presence.projects.find(p=>p.id===id));
const captions=['Scientific research and fact-checking for published Entropy work.','An original scientific diagram, published on Wikimedia Commons.','An independent directory of research-participation opportunities.'];
---
<section class="work-gallery" aria-label="Selected work samples" aria-roledescription="carousel">
  <p class="eyebrow">A closer look at the work</p>
  <div class="gallery-slides">{items.map((p,i)=><figure class="gallery-slide" id={`sample-${i}`} role="group" aria-roledescription="slide" aria-label={`${i+1} of ${items.length}: ${p.name}`}><a href={p.route}><img src={p.image} alt={p.alt} width="800" height="500" loading={i===0?'eager':'lazy'}/></a><figcaption><strong>{p.name}</strong><p>{captions[i]}</p><a href={p.route}>Explore this work ↗</a></figcaption></figure>)}</div>
  <div class="gallery-controls" hidden><div class="gallery-arrows"><button type="button" data-step="-1" aria-label="Previous work sample">←</button><span class="gallery-status" aria-live="polite" aria-atomic="true">1 / 3</span><button type="button" data-step="1" aria-label="Next work sample">→</button></div><div class="gallery-choices" aria-label="Choose a work sample">{items.map((p,i)=><button type="button" data-index={i} aria-label={`Show ${p.name}`} aria-controls={`sample-${i}`} aria-pressed={i===0}><img src={p.image} alt="" width="80" height="50"/><span>{i===0?'Entropy':i===1?'Wikimedia':'Yourself to Science'}</span></button>)}</div></div>
</section>
<script>
for(const gallery of document.querySelectorAll<HTMLElement>('.work-gallery')){
 const slides=[...gallery.querySelectorAll<HTMLElement>('.gallery-slide')];
 const choices=[...gallery.querySelectorAll<HTMLButtonElement>('[data-index]')];
 const controls=gallery.querySelector<HTMLElement>('.gallery-controls');
 let current=0;
 const show=(index:number)=>{current=(index+slides.length)%slides.length;slides.forEach((slide,i)=>slide.hidden=i!==current);choices.forEach((button,i)=>button.setAttribute('aria-pressed',String(i===current)));gallery.querySelector('.gallery-status')!.textContent=`${current+1} / ${slides.length}`;};
 choices.forEach((button,i)=>button.addEventListener('click',()=>show(i)));
 gallery.querySelectorAll<HTMLButtonElement>('[data-step]').forEach(button=>button.addEventListener('click',()=>show(current+Number(button.dataset.step))));
 if(controls)controls.hidden=false;show(0);
}
</script>
