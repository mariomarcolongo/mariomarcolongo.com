---
import { M } from '../lib/artifacts';
import D from '../../data/source.js';
const G=D.presence.aiEvaluationSnapshot;
const panels=[
 {label:'Geometry',name:'Hypermandala · Independent experiment',image:M.screenshots.hypermandala.image,alt:M.screenshots.hypermandala.alt,title:'Explore geometry across dimensions.',role:'An AI-assisted visualization project: 2D plans, 3D forms and experimental 4D extensions. New form additions are still being tested.',url:M.screenshots.hypermandala.url,action:'Try the live explorer',case:'/work/hypermandala'},
 {label:'Notandia',name:'Notandia',image:M.screenshots.notandia.image,alt:M.screenshots.notandia.alt,title:'Publisher watchlists & reference checks.',role:'Requirements, behavior testing and release work. Actual settings from the current source build.',url:'/notandia',action:'See the extension',case:null},
 {label:'AI testing',name:`Gray Swan · ${G.displayDate} snapshot`,image:G.detailImage,alt:'Original public Gray Swan profile detail showing Mario Marcolongo and his dated evaluation results',title:`Proving Ground: #${G.provingGround.rank} · ${G.provingGround.percentile}.`,role:`${G.provingGround.totalBreaks} platform-recorded breaks across chat, image, agent and indirect challenges. Independent model testing; Arena metrics are separate.`,url:G.evidencePath,action:'Inspect the dated scores',case:'/ai-evaluation'}
];
---
<section class="work-gallery artifact-explorer" aria-label="Explore actual work">
 <div class="gallery-controls" role="tablist" aria-label="Choose a project" hidden>{panels.map((p,i)=><button type="button" role="tab" id={`work-tab-${i}`} data-index={i} aria-controls={`work-panel-${i}`} aria-selected={i===0} tabindex={i===0?0:-1}>{p.label}</button>)}</div>
 <div class="gallery-slides">{panels.map((p,i)=><article class="gallery-slide" id={`work-panel-${i}`} aria-label={p.name}><a class:list={['gallery-media',`media-${i}`]} href={p.url}><img src={p.image} alt={p.alt} width="800" height="450" loading={i===0?'eager':'lazy'}/></a><div class="gallery-caption"><p class="sample-name">{p.name}</p><h2><a href={p.url}>{p.title}</a></h2><p class="sample-description">{p.role}</p><div class="gallery-artifact-links"><a href={p.url}>{p.action} ↗</a>{p.case&&<a href={p.case}>My contribution →</a>}</div></div></article>)}</div>
</section>
<script>
for(const gallery of document.querySelectorAll<HTMLElement>('.work-gallery')){
 const panels=[...gallery.querySelectorAll<HTMLElement>('.gallery-slide')];
 const tabs=[...gallery.querySelectorAll<HTMLButtonElement>('[role=tab]')];
 const controls=gallery.querySelector<HTMLElement>('.gallery-controls');let current=0;
 const show=(index:number,focus=false)=>{current=(index+panels.length)%panels.length;panels.forEach((panel,i)=>{panel.hidden=i!==current;panel.setAttribute('role','tabpanel');panel.setAttribute('aria-labelledby',tabs[i].id);});tabs.forEach((tab,i)=>{tab.setAttribute('aria-selected',String(i===current));tab.tabIndex=i===current?0:-1;});if(focus)tabs[current].focus();};
 tabs.forEach((tab,i)=>{tab.addEventListener('click',()=>show(i));tab.addEventListener('keydown',event=>{if(!['ArrowRight','ArrowLeft','Home','End'].includes(event.key))return;event.preventDefault();show(event.key==='Home'?0:event.key==='End'?panels.length-1:current+(event.key==='ArrowRight'?1:-1),true);});});if(controls)controls.hidden=false;gallery.classList.add('gallery-ready');show(0);
}
</script>
