---
const pathname=Astro.url.pathname.replace(/\/$/,'')||'/';
---
<header class="site-header"><a class="site-name" href="/"><img class="name-mark" src="/favicon.svg" width="28" height="28" alt="" aria-hidden="true"/>Mario Marcolongo</a><div class="nav-actions"><nav aria-label="Main navigation"><a href="/work" aria-current={pathname==='/work'?'page':pathname.startsWith('/work/')?'location':undefined}>Work</a><a class="nav-experience" href="/experience" aria-current={pathname==='/experience'?'page':undefined}>Experience</a><a href="/cv" aria-current={pathname==='/cv'?'page':pathname.startsWith('/cv-')?'location':undefined}>Résumé</a><a href="/#contact">Contact</a></nav><button id="themeToggle" type="button" aria-label="Switch color theme" hidden><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M20 15.5A8 8 0 0 1 8.5 4a8 8 0 1 0 11.5 11.5Z"/></svg></button></div></header>
<script>
const button=document.querySelector<HTMLButtonElement>('#themeToggle');
if(button){button.hidden=false;button.addEventListener('click',()=>{const theme=document.documentElement.dataset.theme==='dark'?'light':'dark';document.documentElement.dataset.theme=theme;try{localStorage.setItem('theme',theme)}catch{}button.setAttribute('aria-label',`Switch to ${theme==='dark'?'light':'dark'} theme`);});}
</script>
