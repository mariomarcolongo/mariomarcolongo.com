---
const pathname=Astro.url.pathname.replace(/\.html$/,'').replace(/\/index$/,'').replace(/\/$/,'')||'/';
---
<header class="site-header"><a class="site-name" href="/"><img class="name-mark" src="/favicon.svg" width="28" height="28" alt="" aria-hidden="true"/>Mario Marcolongo</a><div class="nav-actions"><nav aria-label="Main navigation"><a href="/work" aria-current={pathname==='/work'?'page':pathname.startsWith('/work/')?'location':undefined}>Work</a><a href="/evidence" aria-current={pathname==='/evidence'?'page':pathname.startsWith('/evidence/')?'location':undefined}>Evidence</a><a href="/experience" aria-current={pathname==='/experience'?'page':undefined}>Experience</a><a href="/cv" aria-current={pathname==='/cv'?'page':pathname.startsWith('/cv-')?'location':undefined}>Résumé</a><a href="/#contact">Contact</a></nav><button id="themeToggle" type="button" aria-label="Switch color theme" hidden><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/></svg></button></div></header>
<script>
const button=document.querySelector<HTMLButtonElement>('#themeToggle');
if(button){const root=document.documentElement;const label=()=>button.setAttribute('aria-label',`Switch to ${root.dataset.theme==='dark'?'light':'dark'} theme`);button.hidden=false;label();button.addEventListener('click',()=>{const theme=root.dataset.theme==='dark'?'light':'dark';root.classList.add('theme-fade');root.dataset.theme=theme;try{localStorage.setItem('theme',theme)}catch{}label();setTimeout(()=>root.classList.remove('theme-fade'),260);});}
</script>
