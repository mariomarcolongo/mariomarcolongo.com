---
const pathname=Astro.url.pathname.replace(/\/$/,'')||'/';
---
<header class="site-header">
<a class="site-name" href="/">Mario Marcolongo</a>
<nav aria-label="Main navigation">
<a href="/work" aria-current={pathname==='/work'?'page':undefined}>Work</a>
<a class="nav-experience" href="/#experience">Experience</a>
<a href="/cv" aria-current={pathname==='/cv'?'page':undefined}>Résumé</a>
<a href="/#contact">Contact</a>
<button id="themeToggle" type="button" aria-label="Switch color theme" hidden>Theme</button>
</nav>
</header>
<script>
const button=document.querySelector<HTMLButtonElement>('#themeToggle');
if(button){button.hidden=false;button.addEventListener('click',()=>{const theme=document.documentElement.dataset.theme==='dark'?'light':'dark';document.documentElement.dataset.theme=theme;try{localStorage.setItem('theme',theme)}catch{}button.setAttribute('aria-label',`Switch to ${theme==='dark'?'light':'dark'} theme`);});}
</script>
