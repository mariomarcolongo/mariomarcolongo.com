---
import { V, M, R, featuredVideos, aircReels } from '../lib/artifacts';
import VideoCard from './VideoCard.astro';
import ReelCard from './ReelCard.astro';
const {id}=Astro.props;
const additionalVideos=V.videos.items.filter(v=>!M.featuredVideoIds.includes(v.id));
const thumbSelection=V.thumbnails.items.slice(0,6),otherThumbs=V.thumbnails.items.slice(6);
const screenshot=M.screenshots[id];
---
{id==='entropy'?<div class="published-artifacts"><section id="video-work"><h2>Published video projects</h2><p>Research, writing, fact-checking and visual production in varying combinations. Featured here are the shark-attack work and cannabis series. This is a selection for this portfolio; the Entropy profile lists the broader collection. Roles on accompanying maps and articles are identified separately.</p><div class="video-grid">{featuredVideos.map(v=><VideoCard video={v} showRole/>)}</div><details class="artifact-disclosure"><summary>Show {additionalVideos.length} more video entries</summary><div class="video-grid">{additionalVideos.map(v=><VideoCard video={v}/>)}</div></details><a href={V.videos.playlist}>Open the original writing, fact-checking &amp; visualization playlist ↗</a><p class="artifact-date">Playlist captured {V.observedAt}. This includes videos and short-form entries; it is separate from the older organizational inventory.</p></section><section id="reel-work"><h2>Reels &amp; AIRC data visualization</h2><p>I personally created the data visualizations for the AIRC reels that feature them. The complete reels are collaborative productions; these previews come from the published posts.</p><div class="reel-grid">{aircReels.map(r=><ReelCard reel={r}/>)}</div><details class="artifact-disclosure"><summary>Browse the other {R.items.length-aircReels.length} reels</summary><div class="reel-grid">{R.items.filter(r=>!r.airc).map(r=><ReelCard reel={r}/>)}</div></details><p class="artifact-date">{R.items.length} Instagram entries in the profile, captured {R.observedAt}. TikTok reposts are not counted as additional pieces. AIL collaborations are separate from AIRC.</p></section><section id="thumbnail-work"><h2>Thumbnail design &amp; direction</h2><p>Selected work I created, co-created or guided through concepts and instructions. The role varies by project; these images do not imply sole design authorship.</p><div class="video-grid thumbnail-grid">{thumbSelection.map(v=><VideoCard video={v}/>)}</div><details class="artifact-disclosure"><summary>View the remaining {otherThumbs.length} thumbnail projects</summary><div class="video-grid thumbnail-grid">{otherThumbs.map(v=><VideoCard video={v}/>)}</div></details><a href={V.thumbnails.playlist}>Open all {V.thumbnails.items.length} entries in the thumbnail playlist ↗</a></section><section id="website-work"><h2>Website delivery &amp; published articles</h2><figure class="actual-artifact"><a href={M.screenshots['entropy-website'].url}><img src={M.screenshots['entropy-website'].image} alt={M.screenshots['entropy-website'].alt} width="1280" height="720" loading="lazy"/></a><figcaption>{M.screenshots['entropy-website'].caption}</figcaption></figure><p>I designed and built the WordPress site and continue its publishing, hosting, DNS/SSL and technical operation.</p><div class="article-links">{M.articles.map(a=><article><p class="meta">{a.role}</p><h3><a href={a.url}>{a.title} ↗</a></h3></article>)}</div><figure class="actual-artifact"><a href={M.screenshots['entropy-article'].url}><img src={M.screenshots['entropy-article'].image} alt={M.screenshots['entropy-article'].alt} width="1440" height="900" loading="lazy"/></a><figcaption>{M.screenshots['entropy-article'].caption}</figcaption></figure></section><section><h2>Original data views</h2><div class="artifact-tile-grid">{['entropy-map','entropy-size','entropy-cannabis'].map(key=><a class="artifact-tile" href={M.screenshots[key].url}><img src={M.screenshots[key].image} alt={M.screenshots[key].alt} width="1000" height="827" loading="lazy"/><span>{M.screenshots[key].caption} ↗</span></a>)}</div><a href={M.attributionSource}>Roles and selected projects on my Entropy profile ↗</a></section></div>:screenshot&&<figure class="actual-artifact"><a href={screenshot.url}><img src={screenshot.image} alt={screenshot.alt} width="1280" height="720" loading="lazy"/></a><figcaption>{screenshot.caption} · captured {M.capturedAt}.{id==='notandia'&&' This is the current local source build; the Chrome Store listing carries an older interface.'}</figcaption></figure>}
