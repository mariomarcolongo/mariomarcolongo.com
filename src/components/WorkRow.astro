---
const { project: p } = Astro.props;
---
<article class:list={['work-row', { 'has-highlight': p.highlight }]}>
  <div class="work-description">
    <p class="meta">{p.status}</p>
    <h3><a href={p.route}>{p.name}</a></h3>
    <p>{p.text}</p>
    <div class="source-links">
      <a class="case-link" href={p.route}>Explore the work <span aria-hidden="true">↗</span></a>
      {p.links[0] && <a href={p.links[0].url}>{p.links[0].label}</a>}
    </div>
  </div>
  {p.highlight && <aside class="work-highlight" aria-label={`${p.name}: result`}>
    <p class="highlight-number">{p.highlight.value}<span>{p.highlight.label}</span></p>
    <p class="highlight-detail">{p.highlight.detail}</p>
    <p class="highlight-caption">{p.highlight.caption}</p>
  </aside>}
</article>
