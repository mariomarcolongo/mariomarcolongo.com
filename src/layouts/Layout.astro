---
import '../styles/global.css';
import '../styles/presence.css';
import '../styles/studio.css';
import D from '../../data/source.js';
const P = D.presence;
const {title = `Mario Marcolongo — ${P.currentPositioning}`, description = P.description, canonical = `${P.canonicalUrl}${Astro.url.pathname}`, noIndex = false} = Astro.props;
const markdown = Astro.url.pathname === '/' ? '/index.md' : `${Astro.url.pathname.replace(/\/$/, '').replace(/\.html$/, '')}.md`;
const graph = {'@context':'https://schema.org','@type':'ProfilePage',name:title,url:canonical,mainEntity:{'@type':'Person','@id':`${P.canonicalUrl}/#person`,name:P.name,url:P.canonicalUrl,description:P.machineSummary,email:`mailto:${P.email}`,sameAs:[P.github,P.linkedin,P.orcidUrl]}};
---
<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>{title}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/>
<meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:url" content={canonical}/>
<meta name="twitter:card" content="summary"/><meta name="theme-color" content="#FAF9F6"/>
<link rel="icon" href="/favicon.svg" type="image/svg+xml"/>
<link rel="alternate" type="text/markdown" href={markdown}/><link rel="describedby" type="text/plain" href="/llms.txt"/>
{noIndex && <meta name="robots" content="noindex"/>}
<script type="application/ld+json" set:html={JSON.stringify(graph).replace(/</g,'\\u003c')}/>
<script is:inline>try{document.documentElement.dataset.theme=localStorage.getItem('theme')||'light'}catch{}</script>
<slot name="head"/>
</head>
<body><a class="skip-link" href="#main-content">Skip to content</a><slot/></body>
</html>
