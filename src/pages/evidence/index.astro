---
import Layout from '../../layouts/Layout.astro';import SiteNav from '../../components/SiteNav.astro';import SiteFooter from '../../components/SiteFooter.astro';import D from '../../../data/source.js';const P=D.presence;
---
<Layout title="Evidence index — Mario Marcolongo"><SiteNav/><main id="main-content" class="presence-shell case-shell"><h1>Evidence and its limits.</h1><p>Original sources establish different things: attribution, maintainer acceptance, a dated platform result or the existence of a public artifact. Publication is not automatically independent verification.</p><ul class="case-index">{P.claims.map(c=><li><h2>{c.text}</h2><p>{c.limitation}</p><p class="meta">{c.engagementType.replaceAll('_',' ')} · {c.evidenceType.replaceAll('_',' ')} · Owner: {c.sourceOwner.replaceAll('_',' ')} · Reviewed {c.lastReviewedAt}</p>{c.sourceUrl ? <a href={c.sourceUrl}>Inspect source</a> : <p>{c.sourceNote || 'Private institutional transcript supplied by the student; not published.'}</p>}</li>)}</ul><p><a href="/investigations">Attributed source investigations</a> · <a href={P.languages.sourceUrl}>EF SET certificate</a> · <a href="/profile.json">Structured claim records</a></p></main><SiteFooter/></Layout>
