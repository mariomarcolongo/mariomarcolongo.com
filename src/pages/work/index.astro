---
import Layout from '../../layouts/Layout.astro';import SiteNav from '../../components/SiteNav.astro';import SiteFooter from '../../components/SiteFooter.astro';import WorkRow from '../../components/WorkRow.astro';import D from '../../../data/source.js';const P=D.presence;
---
<Layout title="Selected work — Mario Marcolongo"><SiteNav/><main id="main-content" class="presence-shell"><p class="eyebrow">Selected work</p><h1>Research, tools &amp; contributions.</h1><p class="lede">Scientific source work, practical tools and accepted open-source contributions.</p><p>{P.authorship}</p>{P.projects.filter(project=>project.id!=='telegram').map(project=><WorkRow project={project}/>)}<section class="presence-section"><h2>Supporting work</h2><p><a href="/work/telegram">Telegram and cloud automation</a> documents a practical workflow and its architecture. <a href="/research-operations">Qualitative research support</a> describes a scoped volunteer contribution in a University of Padua project.</p><p><a href="https://github.com/jnton/Questionnaire-of-Cognitive-and-Affective-Empathy-QCAE-online-questionnaire">QCAE questionnaire implementation</a> makes an existing instrument available online. It does not establish a new instrument or independent psychometric validation.</p></section></main><SiteFooter/></Layout>
