---
import Layout from '../../layouts/Layout.astro';import SiteNav from '../../components/SiteNav.astro';import SiteFooter from '../../components/SiteFooter.astro';import WorkRow from '../../components/WorkRow.astro';import D from '../../../data/source.js';const P=D.presence;const projects=P.projects.filter(project=>project.id!=='telegram');
---
<Layout title="Selected work — Mario Marcolongo"><SiteNav/><main id="main-content" class="presence-shell"><p class="eyebrow">Selected work</p><h1>Research, tools &amp; contributions.</h1><p class="lede">Scientific source work, practical tools and accepted open-source contributions.</p><p>{P.authorship}</p><div class="work-filters" role="group" aria-label="Filter work by area" hidden><button type="button" data-filter="all" aria-pressed="true">All work</button><button type="button" data-filter="research" aria-pressed="false">Research &amp; sources</button><button type="button" data-filter="tools" aria-pressed="false">Tools &amp; visualizations</button></div><p class="work-result-count" role="status" aria-live="polite">{projects.length} projects</p><div class="project-gallery">{projects.map(project=><WorkRow project={project}/>)}</div><section class="presence-section"><h2>Further experience &amp; contributions</h2><p><a href="/experience">Full experience and responsibilities</a> brings together paid work, volunteer research support and independent contributions.</p><p><a href="/work/wikimedia">Wikipedia, Wikidata &amp; Wikimedia Commons</a>: sustained source review, structured-data work and scientific communication.</p><p><a href="/work/atlas">AI Safety Formalization Atlas</a>: five merged contributions to source auditing, citation provenance and repository tooling, plus a September 2026 draft coauthorship.</p><p><a href="/work/telegram">Telegram and cloud automation</a> documents a practical workflow and its architecture. <a href="/research-operations">Qualitative research support</a> describes a scoped volunteer contribution in a University of Padua project.</p><p><a href="https://github.com/mariomarcolongo/Questionnaire-of-Cognitive-and-Affective-Empathy-QCAE-online-questionnaire">QCAE questionnaire implementation</a> makes an existing instrument available online. It does not establish a new instrument or independent psychometric validation.</p><p><a href="https://mariomarcolongo.github.io/emergent-humanity/">Emergent Humanity</a> is an independent interactive narrative and network simulation: concept and interaction design with AI-assisted implementation.</p></section></main><SiteFooter/></Layout>
<script>
const filters=document.querySelector<HTMLElement>('.work-filters');
if(filters){const cards=[...document.querySelectorAll<HTMLElement>('[data-work-kind]')];const buttons=[...filters.querySelectorAll<HTMLButtonElement>('button')];filters.hidden=false;buttons.forEach(button=>button.addEventListener('click',()=>{const selected=button.dataset.filter;buttons.forEach(b=>b.setAttribute('aria-pressed',String(b===button)));cards.forEach(card=>card.hidden=selected!=='all'&&card.dataset.workKind!==selected);const count=cards.filter(card=>!card.hidden).length;document.querySelector('.work-result-count')!.textContent=`${count} projects`; }));}
</script>
