---
import Layout from '../../layouts/Layout.astro';
import SiteNav from '../../components/SiteNav.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import cases from '../../../data/investigation-cases.js';
const examples = [cases.syndromicAutism, cases.giannino];
const translations = [cases.danielaBortoletto, cases.shadowLibrary];
const originalArticle = cases.freedomCities;
const wikidata = cases.wikidataTerminology;
const bibliography = cases.wikidataBibliography;
---

<Layout title="Wikipedia, Wikidata & Wikimedia Commons — Mario Marcolongo">
  <SiteNav />
  <main id="main-content" class="presence-shell case-shell">
    <p class="eyebrow">Public contributor · Since 2018</p>
    <h1>Making sources easier to trust and understand.</h1>
    <p class="lede">My Wikimedia work combines English-to-Italian translation and adaptation, original explanatory writing, citation review, structured-data editing and scientific visualizations. The public record shows both the edits and the material behind them.</p>
    <div class="source-links">
      <a href="https://commons.wikimedia.org/wiki/Special:CentralAuth/Digressivo">Cross-project contribution record</a>
      <a href="/investigations">Detailed source investigations</a>
    </div>

    <section aria-labelledby="translation-examples">
      <h2 id="translation-examples">English-to-Italian translation and adaptation</h2>
      <p>These articles began as English-to-Italian translations. My work included terminology research, source checks, citation repair and adaptation for Italian readers. The reading links open my published contribution revisions, saved under my Digressivo account. The English source versions and full histories are listed separately; current collaborative articles may include later edits.</p>
      {translations.map(c => (
        <article id={c.id} class="presence-section">
          <h3>{c.title}</h3>
          <p>{c.context}</p>
          <ul>{c.work.slice(0, 2).map(work => <li>{work}</li>)}</ul>
          <p><a href={c.links[0].href}>{c.links[0].label} ↗</a></p>
          <details>
            <summary>Source versions and attribution</summary>
            <ul>{c.links.slice(1).map(link => <li><a href={link.href}>{link.label} ↗</a></li>)}</ul>
          </details>
        </article>
      ))}
    </section>

    <section aria-labelledby="english-writing">
      <h2 id="english-writing">Original English-language writing</h2>
      <article class="presence-section">
        <h3>{originalArticle.title}</h3>
        <p>{originalArticle.context}</p>
        <ul>{originalArticle.work.slice(0, 2).map(work => <li>{work}</li>)}</ul>
        <p><a href={originalArticle.links[0].href}>{originalArticle.links[0].label} ↗</a></p>
        <details>
          <summary>Article history and current version</summary>
          <ul>{originalArticle.links.slice(1).map(link => <li><a href={link.href}>{link.label} ↗</a></li>)}</ul>
        </details>
      </article>
      <p class="evidence-note">The initial revisions are attributed to my Digressivo account. Current Wikipedia articles are collaborative and include later changes by other editors.</p>
    </section>

    <section>
      <h2>Selected source-review contributions</h2>
      {examples.map(c => (
        <article class="presence-section">
          <h3>{c.title}</h3>
          <p>{c.context}</p>
          <ul>{c.work.slice(0, 2).map(work => <li>{work}</li>)}</ul>
          <a href={c.links[0].href}>{c.links[0].label} ↗</a>
        </article>
      ))}
    </section>

    <section>
      <h2>Scientific visual communication</h2>
      <figure>
        <img src="/media/work/wikimedia-clinical-overlap.svg" alt="Diagram of overlapping genes associated with clinical phenotypes" width="800" height="500" />
        <figcaption>Original diagram published on Wikimedia Commons.</figcaption>
      </figure>
      <details>
        <summary>What does this diagram explain?</summary>
        <p>Intersecting regions show genes associated with more than one clinical phenotype. This helps readers see shared associations alongside the sourced explanation; it is not a diagnostic tool.</p>
      </details>
      <a href="/work/scientific-visualizations">View the diagrams, data views and source trail ↗</a>
    </section>

    <section id={bibliography.id} aria-labelledby="bibliography-heading">
      <h2 id="bibliography-heading">{bibliography.title}</h2>
      <p>{bibliography.context}</p>
      <ul>{bibliography.work.map(work => <li>{work}</li>)}</ul>
      <p><a href={bibliography.links[0].href}>{bibliography.links[0].label} ↗</a></p>
      <details>
        <summary>Source records and attributed revisions</summary>
        <ul>{bibliography.links.slice(1).map(link => <li><a href={link.href}>{link.label} ↗</a></li>)}</ul>
      </details>
      <p class="evidence-note">{bibliography.limitations}</p>
    </section>

    <section id={wikidata.id} aria-labelledby="wikidata-heading">
      <h2 id="wikidata-heading">{wikidata.title}</h2>
      <p>{wikidata.context}</p>
      {wikidata.examples.map(example => (
        <article id={example.id} class="presence-section">
          <h3>{example.title}</h3>
          <p><strong>{example.sourceLabel}:</strong> <q lang="en">{example.sourceText}</q></p>
          <p><strong>{example.addedLabel}:</strong> <q lang="it">{example.addedText}</q></p>
          <p>{example.contribution}</p>
          <p><a href={example.links[0].href}>{example.links[0].label} ↗</a></p>
          {example.links.length > 1 && (
            <details>
              <summary>Additional revisions and attribution</summary>
              <ul>{example.links.slice(1).map(link => <li><a href={link.href}>{link.label} ↗</a></li>)}</ul>
            </details>
          )}
        </article>
      ))}
      <p>{wikidata.limitations}</p>
      <a href={wikidata.links[0].href}>{wikidata.links[0].label} ↗</a>
    </section>
    <p class="evidence-note">Selected article examples come from the September 2026 evidence review. Reading versions and attribution records were rechecked on 23 October 2026. The Wikidata terminology and bibliography examples and their attributed revisions were reviewed on 26 October 2026. Primary article links use revisions saved by my Digressivo account; full histories show the surrounding contributions.</p>
  </main>
  <SiteFooter />
</Layout>
