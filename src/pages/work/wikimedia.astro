---
import Layout from '../../layouts/Layout.astro';
import SiteNav from '../../components/SiteNav.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import cases from '../../../data/investigation-cases.js';
const examples=[cases.syndromicAutism,cases.giannino];
---
<Layout title="Wikipedia, Wikidata & Wikimedia Commons — Mario Marcolongo"><SiteNav/><main id="main-content" class="presence-shell case-shell"><p class="eyebrow">Public contributor · Since 2018</p><h1>Making sources easier to trust and understand.</h1><p class="lede">My Wikimedia work combines citation review, source reconciliation, structured-data editing and scientific visualizations. The public record shows both the edits and the material behind them.</p><div class="source-links"><a href="https://commons.wikimedia.org/wiki/Special:CentralAuth/Digressivo">Cross-project contribution record</a><a href="/investigations">Detailed source investigations</a></div>
<section><h2>Selected contributions</h2>{examples.map(c=><article class="presence-section"><h3>{c.title}</h3><p>{c.context}</p><ul>{c.work.slice(0,2).map(w=><li>{w}</li>)}</ul><a href={c.links[0].href}>{c.links[0].label} ↗</a></article>)}</section>
<section><h2>Scientific visual communication</h2><figure><img src="/media/work/wikimedia-clinical-overlap.svg" alt="Diagram of overlapping genes associated with clinical phenotypes" width="800" height="500"/><figcaption>Original diagram published on Wikimedia Commons.</figcaption></figure><details><summary>What does this diagram explain?</summary><p>Intersecting regions show genes associated with more than one clinical phenotype. This helps readers see shared associations alongside the sourced explanation; it is not a diagnostic tool.</p></details><a href="/work/scientific-visualizations">View the diagrams, data views and source trail ↗</a></section>
<section><h2>Structured information</h2><p>Wikidata work complements prose editing through structured records, references and connections between resources. These contributions sit alongside my work maintaining the Yourself to Science directory.</p><a href="https://www.wikidata.org/wiki/Special:Contributions/Digressivo">Inspect Wikidata contributions ↗</a></section><p class="evidence-note">Selected examples come from the September 2026 evidence review. Original revisions establish attribution; underlying sources support the subject matter. Contribution totals are omitted here rather than presented as live measures of impact.</p></main><SiteFooter/></Layout>
