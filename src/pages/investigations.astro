---
import Layout from '../layouts/Layout.astro';import SiteNav from '../components/SiteNav.astro';import SiteFooter from '../components/SiteFooter.astro';import cases from '../../data/investigation-cases.js';
import D from '../../data/source.js';
import PageHead from '../components/PageHead.astro';
const methods=D.presence.investigationMethods;
const selected=[cases.syndromicAutism,cases.giannino,cases.nebula,cases.teodorani];
---
<Layout title="Source investigations — Mario Marcolongo" description="Source investigations by Mario Marcolongo: archival recovery, privacy and corporate records, and biomedical evidence, with attributable edits and stated limits."><SiteNav/><main id="main-content" class="presence-shell ruled"><PageHead title="From conflicting records to a defensible conclusion." status="Public-source contributions"><p class="lede">Selected cases showing what I checked, which evidence changed the conclusion and what remains uncertain.</p><p>I recover source material, reconcile conflicting accounts and turn complex records into sourced explanations. Original revisions identify my contributions; linked records support the findings.</p></PageHead><section aria-labelledby="investigation-methods"><h2 id="investigation-methods">Independent investigation methods</h2><p>{methods.summary}</p><p>{methods.sourceRecovery}</p><p>{methods.scope}</p></section>{selected.map((c,i)=><section id={c.id} class="case-study"><p class="meta">Case {i+1}</p><h2>{c.title}</h2><p>{c.context}</p><h3>What I checked</h3><ul>{c.work.map(w=><li>{w}</li>)}</ul><div class="source-links">{c.links.slice(0,3).map(l=><a href={l.href}>{l.label}</a>)}</div>{c.links.length>3&&<details><summary>Additional revisions and sources</summary><ul>{c.links.slice(3).map(l=><li><a href={l.href}>{l.label} ↗</a></li>)}</ul></details>}<h3>Result and limits</h3><p>{c.limitations}</p></section>)}<p class="evidence-note">Source cases reviewed 12 September 2026; the Nebula corporate examples and their attributed revisions were rechecked on 26 October 2026. Later legal or corporate developments require a fresh source check. These cases describe documented source work and do not provide legal or medical advice.</p></main><SiteFooter/></Layout>
