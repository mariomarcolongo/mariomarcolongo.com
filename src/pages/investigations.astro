---
import Layout from '../layouts/Layout.astro';import SiteNav from '../components/SiteNav.astro';import SiteFooter from '../components/SiteFooter.astro';import cases from '../../data/investigation-cases.js';
const selected=[cases.syndromicAutism,cases.giannino,cases.nebula];
---
<Layout title="Source investigations — Mario Marcolongo" description="Selected source investigations with attributable edits, checks and explicit limits."><SiteNav/><main id="main-content" class="presence-shell case-shell"><p class="eyebrow">Public-source contributions</p><h1>From conflicting records to a defensible conclusion.</h1><p class="lede">Selected cases showing what I checked, which evidence changed the conclusion and what remains uncertain.</p><p>These are public-source and encyclopedia contributions. The original revision or discussion supports attribution; the underlying sources support the subject matter. Those are different kinds of evidence.</p>{selected.map(c=><section><h2>{c.title}</h2><p>{c.context}</p><h3>What I checked</h3><ul>{c.work.map(w=><li>{w}</li>)}</ul><div class="source-links">{c.links.slice(0,3).map(l=><a href={l.href}>{l.label}</a>)}</div><h3>Result and limits</h3><p>{c.limitations}</p></section>)}<p class="evidence-note">Reviewed 12 Sep 2026. Later legal or corporate developments require a fresh source check. These cases describe documented source work and do not provide legal or medical advice.</p></main><SiteFooter/></Layout>
