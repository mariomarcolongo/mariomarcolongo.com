---
import ProfessionalCredentials from '../components/ProfessionalCredentials.astro';
import EmailLink from '../components/EmailLink.astro';
import Layout from '../layouts/Layout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import TrackChart from '../components/TrackChart.astro';
import { M } from '../lib/artifacts';
import D from '../../data/source.js';
import cases from '../../data/investigation-cases.js';
const P=D.presence, G=P.aiEvaluationLatestSnapshot||P.aiEvaluationSnapshot, F=P.aiEvaluationFinalResult, N=P.redTeamNetwork;
const proofLevel=G.provingGround.percentile.replace(/^./,c=>c.toUpperCase());
const shortDate=value=>new Intl.DateTimeFormat('en-GB',{day:'numeric',month:'short',year:'numeric',timeZone:'UTC'}).format(new Date(value));
const record=[
 {when:shortDate(G.observedAt),datetime:G.observedAt,claim:`${proofLevel} of Gray Swan Proving Ground`,detail:`#${G.provingGround.rank} · ${G.provingGround.totalBreaks} platform-recorded breaks`,href:G.evidencePath},
 {when:'Oct 2026',datetime:N.startDate.slice(0,7),claim:`${N.role}, ${N.organization} ${N.name}`,detail:'Project-based network of independent specialists',href:'/ai-evaluation#syntony'},
 {when:'Since 2023',datetime:'2023-06',claim:'Paid scientific and website work',detail:'Entropy for Life, Italian science communication',href:'/work/entropy'},
 {when:'Oct 2026',datetime:'2026-10',claim:'Coauthor, AI Safety Formalization Atlas preprint',detail:'Five merged PRs · public on Zenodo',href:'/work/atlas'},
 {when:'Nov 2026',datetime:'2026-11',claim:'Merged fix to Basic Memory, an open-source AI knowledge base',detail:'Agent tool output · regression test',href:'/ai-evaluation#basic-memory'},
 {when:'2024',datetime:'2024',claim:'Diagram reused in a Springer Nature book chapter',detail:'Palgrave Macmillan · four Wikipedia language editions',href:'/work/wikimedia#diagram-reuse'}
];
const phoneFirst='(max-width:480px) 240px, (max-width:859px) 100vw, 460px';
const widths=image=>`${image.replace(/\.webp$/,'-640.webp')} 640w, ${image} ${image.includes('entropy-shark')||image.includes('notandia')?1000:1280}w`;
const investigations=[cases.syndromicAutism,cases.giannino,cases.nebula,cases.teodorani];
const visuals=P.visualArtifacts.filter(v=>['Carcinogen Levels in Yerba Maté','Global Vegetarian Diet Policies'].includes(v.title)).map(v=>({...v,caption:v.title,alt:v.text}));
const tools=[{id:'notandia',title:'Notandia',role:'Product requirements · Testing · Release work',text:'Configurable publisher watchlists and explainable research-integrity signals. Screenshot from the current source build.',route:'/notandia'},{id:'yourself-to-science',title:'Yourself to Science',role:'Founder · Source curation · Maintenance',text:'A directory of research-participation opportunities with filters, inclusion decisions and original-source links.',route:'/work/yourself-to-science'}];
---
<Layout><SiteNav/><main id="main-content" class="home"><div class="presence-shell ruled">
 <header class="hero">
  <p class="eyebrow hero-eyebrow">AI evaluation, information integrity &amp; research</p>
  <h1 id="hero-title">Investigate information.<br/><em>Test systems.<svg class="pen" viewBox="0 0 400 12" aria-hidden="true"><path pathLength="1" d="M3 8.5C62 3.6 118 9.8 176 6.6S300 3.2 397 6.9"/></svg></em></h1>
  <p class="hero-intro">{P.subheadline}</p>
  <div class="actions"><a class="button primary" href="/cv-ai">View my résumé <span class="arrow" aria-hidden="true">→</span></a><a class="button" href="#contact">Discuss a project</a></div>
  <div class="hero-facts"><p>Italy · EU citizen · Native Italian, fluent English · Open to remote work &amp; relocation</p><div class="hero-routes" role="group" aria-label="Other résumés"><span>Other résumés</span><a href="/cv">Scientific research &amp; fact-checking</a><a href="/cv-technical">Software QA &amp; AI workflows</a></div></div>
  <section class="record" aria-labelledby="record-title"><div class="record-head"><h2 id="record-title">On the record</h2><p>Reviewed {shortDate(P.reviewedAt)}</p></div><ol class="record-rows">{record.map(row=><li><a href={row.href}><time datetime={row.datetime}>{row.when}</time> <span class="record-claim"><strong>{row.claim}</strong> <span>{row.detail}</span></span><span class="arrow" aria-hidden="true">→</span></a></li>)}</ol><a class="record-all" href="/evidence">Every claim, with its source and limits&nbsp;→</a></section>
 </header>
 <section id="evidence-work" aria-labelledby="research-title"><div class="band-label"><p class="eyebrow">Source quality &amp; AI evaluation</p></div><div class="band-main"><h2 id="research-title">Contributions you can inspect.</h2>
  <article class="feature"><div class="feature-copy"><p class="meta">Independent adversarial model testing</p><h3><a href="/ai-evaluation">Gray Swan testing record</a></h3><p class="evaluation-result">{proofLevel} of Proving Ground</p><p>Proving Ground: #{G.provingGround.rank} · {G.provingGround.percentile} · {G.provingGround.totalBreaks} platform-recorded breaks across chat, image, agent and indirect challenges. Captured {G.displayDate}.</p><p>Arena: {G.arena.uniqueBreaks} unique breaks · #{G.arena.rank} · {G.arena.points.toLocaleString('en-US')} points · {G.arena.submissions} submissions. Captured {G.displayDate}.</p><p>Lucky Break: Level Up: {F.rank}th of {F.participants} participants, with {F.recordedBreaks} platform-recorded breaks.</p><p class="section-note">Dated platform results. Arena and Proving Ground are separate; the evidence page preserves the displayed-total discrepancy.</p><div class="source-links"><a href={G.evidencePath}>Inspect the original scores&nbsp;→</a><a href="/cv-ai">AI evaluation résumé&nbsp;→</a></div></div><TrackChart snapshot={G}/></article>
  <article class="feature"><div class="feature-copy"><p class="meta">Accepted open-source changes</p><h3><a href="/work/atlas">AI Safety Formalization Atlas</a></h3><p>Five merged PRs covering source auditing, citation provenance and repository tooling, including a source-backed guide to AI agent instructions. Coauthor of the Atlas preprint, publicly available on Zenodo since October 2026.</p><p class="review-quote">“Good work on improving sources!” <a href="https://github.com/mbrcic/ai-safety-formalization-atlas/pull/70#pullrequestreview-5334332149">— maintainer review of PR #70&nbsp;↗</a></p><div class="source-links"><a href="/work/atlas">Inspect my contributions&nbsp;→</a><a href="https://github.com/mbrcic/ai-safety-formalization-atlas/blob/66ceba19c1904f00b2a734486ee0de3f5fc5a470/docs/guide/agent-instruction-design.md">Read my agent-instruction guide&nbsp;↗</a></div></div><a class="feature-media" href={M.screenshots.atlas.url}><img src={M.screenshots.atlas.image} srcset={widths(M.screenshots.atlas.image)} sizes={phoneFirst} alt={M.screenshots.atlas.alt} width="1280" height="644" loading="lazy"/></a></article>
 </div></section>
 <section id="selected-work" aria-labelledby="entropy-title"><div class="band-label"><p class="eyebrow">Paid scientific work · Since 2023</p></div><div class="band-main"><h2 id="entropy-title">Entropy for Life</h2><div class="feature"><div class="feature-copy"><p>My work includes primary-literature research, scientific fact-checking, scripts and articles, this map’s data collection and visualization, and designing and operating the WordPress website. I also created the data visualizations in AIRC reels that feature them; complete productions are collaborative.</p><p class="meta">Client context: {P.entropyOrganization.context}</p><div class="source-links"><a href="/work/entropy">Explore my responsibilities &amp; published work&nbsp;→</a><a href="/work/entropy#video-work">Sharks &amp; cannabis videos&nbsp;↗</a><a href="/work/entropy#reel-work">AIRC reels&nbsp;↗</a><a href="/work/entropy#thumbnail-work">Thumbnail design &amp; direction&nbsp;↗</a></div></div><a class="feature-media" href={M.screenshots['entropy-map'].url}><img src={M.screenshots['entropy-map'].image} srcset={widths(M.screenshots['entropy-map'].image)} sizes={phoneFirst} alt={M.screenshots['entropy-map'].alt} width="1000" height="827" loading="lazy"/><span>My published interactive shark-attack map ↗</span></a></div></div></section>
 <section aria-labelledby="investigations-title"><div class="band-label"><p class="eyebrow">Information integrity &amp; investigations</p><a href="/investigations">Inspect the cases&nbsp;→</a></div><div class="band-main"><h2 id="investigations-title">Follow the evidence.</h2><p>I recover missing sources, reconcile conflicting records and examine scientific, privacy and corporate claims. Public revision histories show my contributions and the evidence behind them.</p><ul class="line-list">{investigations.map(item=><li><a href={`/investigations#${item.id}`}>{item.title} <span aria-hidden="true">→</span></a></li>)}<li><a href="/work/wikimedia">Scientific &amp; structured-data work <span aria-hidden="true">→</span></a></li></ul></div></section>
 <section id="services" aria-labelledby="services-title"><div class="band-label"><p class="eyebrow">Consulting &amp; project delivery</p><a href="#contact">Discuss your project&nbsp;→</a></div><div class="band-main"><h2 id="services-title">How I can help.</h2><p>{P.engagement.audience} {P.engagement.projectScope}</p><ul class="service-list">{P.services.map(service=><li><h3>{service.name}</h3><p>{service.description}</p><a href={service.evidencePath}>See the work<span class="vh">: {service.name}</span>&nbsp;→</a></li>)}</ul></div></section>
 <section aria-labelledby="work-title"><div class="band-label"><p class="eyebrow">Independent products</p><a href="/work">All projects&nbsp;→</a></div><div class="band-main"><h2 id="work-title">Tools for research.</h2><div class="card-grid">{tools.map(t=><article class="card"><a class="card-image" href={t.route}><img src={M.screenshots[t.id].image} srcset={widths(M.screenshots[t.id].image)} sizes={phoneFirst} alt={M.screenshots[t.id].alt} width="1280" height="720" loading="lazy"/></a><p class="meta">{t.role}</p><h3><a href={t.route}>{t.title}</a></h3><p>{t.text}</p><div class="source-links"><a href={t.route}>My contribution&nbsp;→</a><a href={M.screenshots[t.id].url}>{t.id==='notandia'?'Source & installation':'Try the directory'}&nbsp;↗</a></div></article>)}</div></div></section>
 <section aria-labelledby="visual-title"><div class="band-label"><p class="eyebrow">Published visual explanations</p><a href="/work/scientific-visualizations">Full collection&nbsp;→</a></div><div class="band-main"><h2 id="visual-title">Make the evidence visible.</h2><div class="artifact-tile-grid mobile-preview-strip" tabindex="0" role="region" aria-label="Published chart previews">{visuals.map(v=><a class="artifact-tile" href={v.url}><img src={v.image} alt={v.alt} width="800" height="600" loading="lazy"/><span>{v.caption} <span aria-hidden="true">↗</span></span></a>)}</div><p class="preview-scroll-hint">Scroll sideways to preview more charts.</p><p class="section-note">Original Wikimedia Commons diagrams. Tableau maps, Flourish stories and further data views remain in the full archive.</p></div></section>
 <ProfessionalCredentials/>
 <section aria-labelledby="background-title"><div class="band-label"><p class="eyebrow">Experience &amp; education</p><a href="/experience">Full experience &amp; responsibilities&nbsp;→</a></div><div class="band-main"><h2 id="background-title">The wider background.</h2><div class="background-list" style="margin-top:18px">{P.experience.filter(e=>['/work/wikimedia','/research-operations'].includes(e.route)).map(e=><article><p class="meta">{e.period}</p><h3><a href={e.route}>{e.name}</a></h3><p>{e.text}</p></article>)}<article><p class="meta">Aug 2026–Present · Open UAS</p><h3>Metropolia University of Applied Sciences</h3><p>Open UAS IT path studies toward a BEng. Python Programming: 3 ECTS, Pass (September 2026). Continuing Python, SQL and quantitative foundations.</p></article></div></div></section>
 <section aria-labelledby="further-title"><div class="band-label"><p class="eyebrow">Further explorations</p></div><div class="band-main further"><a class="feature-media" href={M.screenshots.protein.url}><img src={M.screenshots.protein.image} srcset={widths(M.screenshots.protein.image)} sizes={phoneFirst} alt={M.screenshots.protein.alt} width="1280" height="720" loading="lazy"/></a><div class="feature-copy"><h2 id="further-title">Protein / kg explorer</h2><p>Explore national protein supply relative to estimated bodyweight. Sources and model assumptions stay visible.</p><div class="source-links"><a href={M.screenshots.protein.url}>Explore the data&nbsp;↗</a><a href="/work/hypermandala">Hypermandala source &amp; scope&nbsp;→</a><a href="/work/telegram">Telegram &amp; cloud automation&nbsp;→</a><a href="/work">More projects &amp; contributions&nbsp;→</a></div></div></div></section>
</div>
<section class="contact-panel" id="contact" aria-labelledby="contact-title"><div class="contact-inner ruled"><div class="contact-identity"><img src="/media/mario-marcolongo-portrait.webp" alt="Portrait of Mario Marcolongo" width="72" height="72" loading="lazy"/><p class="eyebrow">International opportunities</p></div><div class="contact-main"><div class="contact-copy"><h2 id="contact-title">Discuss a role or project.</h2><p>{P.contact}</p><p>{P.engagement.projectBrief}</p><EmailLink class="contact-email">{P.email}</EmailLink></div><div class="contact-aside"><p>AI evaluation &amp; red teaming<br/>Information integrity &amp; research<br/>AI workflows &amp; software QA</p><p>{P.engagement.contactPreference}</p><p class="meta">{P.engagement.hours}</p><p class="meta">{P.engagement.delivery}</p><p class="meta">{P.availability}</p><div class="contact-links"><a href="/cv">View application résumés&nbsp;→</a><a href={P.malt}>Book through Malt&nbsp;↗</a></div></div></div></div></section>
</main><SiteFooter/></Layout>
