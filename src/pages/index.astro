---
import Layout from '../layouts/Layout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import WorkGallery from '../components/WorkGallery.astro';
import { M } from '../lib/artifacts';
import D from '../../data/source.js';
const P=D.presence, G=P.aiEvaluationSnapshot;
const visuals=P.visualArtifacts.filter(v=>['Carcinogen Levels in Yerba Maté','Global Vegetarian Diet Policies'].includes(v.title)).map(v=>({...v,caption:v.title,alt:v.text}));
const tools=[{id:'notandia',title:'Notandia',role:'Product requirements · Testing · Release work',text:'Configurable publisher watchlists and explainable research-integrity signals. Screenshot from the current source build.',route:'/notandia'},{id:'yourself-to-science',title:'Yourself to Science',role:'Founder · Source curation · Maintenance',text:'A directory of research-participation opportunities with filters, inclusion decisions and original-source links.',route:'/work/yourself-to-science'}];
---
<Layout><SiteNav/><main id="main-content" class="presence-shell home-shell">
 <section class="home-hero artifact-hero" aria-labelledby="hero-title"><div class="hero-copy"><p class="eyebrow">Mario Marcolongo · Research &amp; technical operations</p><h1 id="hero-title">Scientific evidence.<br/><span>Practical tools.</span></h1><p class="hero-intro">{P.subheadline}</p><p class="hero-context"><a href="/work/entropy">Paid science &amp; website work</a> · <a href="/work/atlas">Five accepted Atlas contributions</a> · <a href="/ai-evaluation">Dated AI-testing results</a></p><div class="actions"><a class="button primary" href="/cv">View résumé →</a><a class="hero-cv" href="#selected-work">Explore the work ↓</a></div><p class="hero-availability"><span aria-hidden="true"></span>Italy · EU citizen · Open to remote work &amp; relocation</p></div><WorkGallery/></section>
 <section class="presence-section delivered-tools" id="selected-work" aria-labelledby="work-title" data-enter><div class="section-heading"><div><p class="eyebrow">Independent products</p><h2 id="work-title">Tools for research.</h2></div><a href="/work">All projects →</a></div><div class="real-tool-grid">{tools.map(t=><article class="real-tool-card"><a class:list={['real-tool-image',`tool-${t.id}`]} href={t.route}><img src={M.screenshots[t.id].image} alt={M.screenshots[t.id].alt} width="1280" height="720" loading="lazy"/></a><div><p class="meta">{t.role}</p><h3><a href={t.route}>{t.title}</a></h3><p>{t.text}</p><div class="source-links"><a href={t.route}>My contribution →</a><a href={M.screenshots[t.id].url}>{t.id==='notandia'?'Source & installation':'Try the directory'} ↗</a></div></div></article>)}</div></section>
 <section class="presence-section research-evidence" aria-labelledby="research-title" data-enter><div class="section-heading"><div><p class="eyebrow">Source quality &amp; AI evaluation</p><h2 id="research-title">Contributions you can inspect.</h2></div></div><div class="evidence-work-grid"><article class="evidence-work-card"><a class="evidence-work-image" href={M.screenshots.atlas.url}><img src={M.screenshots.atlas.image} alt={M.screenshots.atlas.alt} width="1280" height="644" loading="lazy"/></a><div><p class="meta">Accepted open-source changes</p><h3><a href="/work/atlas">AI Safety Formalization Atlas</a></h3><p>Five merged PRs covering source auditing, citation provenance and repository tooling. Listed coauthor of the September 2026 paper draft.</p><p class="review-quote">“Good work on improving sources!” <a href="https://github.com/mbrcic/ai-safety-formalization-atlas/pull/70#pullrequestreview-5334332149">— maintainer review of PR #70 ↗</a></p><a href="/work/atlas">Inspect my contributions →</a></div></article><article class="evidence-work-card gray-evidence"><a class="evidence-work-image" href={G.evidencePath}><img src={G.detailImage} alt="Detail of the original Gray Swan public profile showing Mario Marcolongo and separate Arena and Proving Ground results" width="1184" height="712" loading="lazy"/></a><div><p class="meta">Independent adversarial model testing</p><h3><a href="/ai-evaluation">Gray Swan Proving Ground</a></h3><p class="evaluation-result">#{G.provingGround.rank} · {G.provingGround.percentile}</p><p>{G.provingGround.totalBreaks} platform-recorded breaks across chat, image, agent and indirect challenges. Captured {G.displayDate}.</p><p class="section-note">Dated platform results. Arena is separate; the evidence page preserves the displayed-total discrepancy.</p><p class="meta"><a href="/ai-evaluation#syntony">{P.redTeamNetwork.organization} · {P.redTeamNetwork.name} member</a></p><div class="source-links"><a href={G.evidencePath}>Inspect the original scores →</a><a href="/cv-ai">AI evaluation résumé →</a></div></div></article></div></section>
 <section class="presence-section entropy-case" aria-labelledby="entropy-title" data-enter><a class="entropy-case-image" href={M.screenshots['entropy-map'].url}><img src={M.screenshots['entropy-map'].image} alt={M.screenshots['entropy-map'].alt} width="1280" height="827" loading="lazy"/><span>My published interactive shark-attack map ↗</span></a><div><p class="eyebrow">Paid scientific work · Since 2023</p><h2 id="entropy-title">Entropy for Life</h2><p>My work includes primary-literature research, scientific fact-checking, scripts and articles, this map’s data collection and visualization, and designing and operating the WordPress website. I also created the data visualizations in AIRC reels that feature them; complete productions are collaborative.</p><p class="meta">Client context: {P.entropyOrganization.context}</p><a href="/work/entropy">Explore my responsibilities &amp; published work →</a><div class="section-links"><a href="/work/entropy#video-work">Sharks &amp; cannabis videos ↗</a><a href="/work/entropy#reel-work">AIRC reels ↗</a><a href="/work/entropy#thumbnail-work">Thumbnail design &amp; direction ↗</a></div></div></section>
 <section class="presence-section real-visuals" aria-labelledby="visual-title" data-enter><div class="section-heading"><div><p class="eyebrow">Published visual explanations</p><h2 id="visual-title">Make the evidence visible.</h2></div><a href="/work/scientific-visualizations">Full collection →</a></div><div class="artifact-tile-grid mobile-preview-strip" tabindex="0" role="region" aria-label="Published chart previews">{visuals.map(v=><a class="artifact-tile" href={v.url}><img src={v.image} alt={v.alt} width="800" height="600" loading="lazy"/><span>{v.caption} <span aria-hidden="true">↗</span></span></a>)}</div><p class="preview-scroll-hint">Scroll sideways to preview more charts.</p><p class="section-note">Original Wikimedia Commons diagrams. Tableau maps, Flourish stories and further data views remain in the full archive.</p></section>
 <section class="presence-section background-section" aria-labelledby="background-title" data-enter><div class="background-copy"><p class="eyebrow">Experience &amp; education</p><h2 id="background-title">The wider background.</h2><a href="/experience">Full experience &amp; responsibilities →</a></div><div class="background-list">{P.experience.filter(e=>['/work/wikimedia','/research-operations'].includes(e.route)).map(e=><article><p class="meta">{e.period}</p><h3><a href={e.route}>{e.name}</a></h3><p>{e.text}</p></article>)}<article><p class="meta">Aug 2026–Present · Open UAS</p><h3>Metropolia University of Applied Sciences</h3><p>Non-degree IT path studies. Python Programming: 3 ECTS, Pass (September 2026). Continuing Python, SQL and quantitative foundations.</p></article><a class="investigation-link" href="/investigations">Read the source investigations →</a></div></section>
 <section class="presence-section further-work" aria-labelledby="further-title" data-enter><a href={M.screenshots.protein.url}><img src={M.screenshots.protein.image} alt={M.screenshots.protein.alt} width="1280" height="720" loading="lazy"/></a><div><p class="eyebrow">Further explorations</p><h2 id="further-title">Protein / kg explorer</h2><p>Explore national protein supply relative to estimated bodyweight. Sources and model assumptions stay visible.</p><a href={M.screenshots.protein.url}>Explore the data ↗</a><div class="supporting-links"><a href="/work/hypermandala">Hypermandala source &amp; scope →</a><a href="/work/telegram">Telegram &amp; cloud automation →</a><a href="/work">More projects &amp; contributions →</a></div></div></section>
 <section class="presence-section contact-panel" id="contact" aria-labelledby="contact-title" data-enter><div><p class="eyebrow">International opportunities</p><h2 id="contact-title">Discuss a role or project.</h2><p>{P.contact}</p><a class="contact-email" href={`mailto:${P.email}`}>{P.email} ↗</a></div><div class="contact-aside"><p>Research operations<br/>Source &amp; data quality<br/>Technical support &amp; implementation</p><p class="meta">{P.availability}</p><a href="/cv">View application résumés →</a></div></section>
</main><SiteFooter/></Layout>
<script>
if('IntersectionObserver' in window&&!matchMedia('(prefers-reduced-motion: reduce)').matches){const observer=new IntersectionObserver(entries=>{for(const entry of entries)if(entry.isIntersecting){entry.target.classList.add('entered');observer.unobserve(entry.target);}}, {threshold:.08});document.querySelectorAll('[data-enter]').forEach(el=>observer.observe(el));}
</script>
