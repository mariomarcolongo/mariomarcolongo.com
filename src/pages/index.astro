---
import Layout from '../layouts/Layout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import WorkGallery from '../components/WorkGallery.astro';
import VideoCard from '../components/VideoCard.astro';
import ReelCard from '../components/ReelCard.astro';
import { M, featuredVideos, aircReels } from '../lib/artifacts';
import D from '../../data/source.js';
const P=D.presence;
const visuals=[M.screenshots['entropy-map'],M.screenshots['entropy-size'],...P.visualArtifacts.filter(v=>['Carcinogen Levels in Yerba Maté','Global Vegetarian Diet Policies'].includes(v.title)).map(v=>({...v,caption:v.title,alt:v.title}))];
const tools=[{id:'notandia',title:'Notandia',role:'Product requirements · Testing · Release work',text:'Configurable publisher watchlists and explainable research-integrity signals. Screenshot from the current source build.',route:'/notandia'},{id:'yourself-to-science',title:'Yourself to Science',role:'Founder · Source curation · Maintenance',text:'A directory of research-participation opportunities with filters, inclusion decisions and original-source links.',route:'/work/yourself-to-science'}];
---
<Layout><SiteNav/><main id="main-content" class="presence-shell home-shell">
 <section class="home-hero artifact-hero" aria-labelledby="hero-title"><div class="hero-copy"><p class="eyebrow">Mario Marcolongo · Research &amp; technical operations</p><h1 id="hero-title">Scientific research.<br/><span>Practical tools.</span></h1><p class="hero-intro">I research and fact-check scientific content, create visual explanations, and build and maintain useful websites and tools.</p><p class="hero-context">Paid work with Entropy for Life. Accepted AI-safety source contributions. Independent projects you can explore.</p><div class="actions"><a class="button primary" href="#selected-work">Explore the work ↓</a><a class="hero-cv" href="/cv">View résumé ↗</a></div><p class="hero-availability"><span aria-hidden="true"></span>Based in Italy · Seeking international opportunities</p></div><WorkGallery/></section>
 <section class="presence-section published-section" id="selected-work" aria-labelledby="work-title" data-enter><div class="section-heading"><div><p class="eyebrow">Paid scientific work</p><h2 id="work-title">Entropy for Life</h2></div><a href="/work/entropy">Full contribution record →</a></div><p class="section-intro">Research, fact-checking, scripts and visual production. Featured here: shark attacks and the cannabis series. Responsibilities vary across the collaborative productions.</p><div class="video-grid">{featuredVideos.slice(0,3).map(v=><VideoCard video={v}/>)}</div><div class="section-links"><a href="/work/entropy#video-work">Cannabis series & full video collection →</a><a href="/work/entropy#thumbnail-work">Thumbnail design &amp; direction →</a><a href="/work/entropy#website-work">Website &amp; published articles →</a></div></section>
 <section class="presence-section reel-feature" aria-labelledby="reels-title" data-enter><div class="reel-feature-copy"><p class="eyebrow">Entropy for Life × AIRC</p><h2 id="reels-title">Data stories in short form.</h2><p>My contribution: data visualization for AIRC collaborations. The reels are produced with the Entropy for Life team.</p><a href="/work/entropy#reel-work">AIRC examples &amp; all 21 reels →</a></div><div class="reel-grid">{aircReels.slice(0,2).map(r=><ReelCard reel={r}/>)}</div></section>
 <section class="presence-section delivered-tools" aria-labelledby="tools-title" data-enter><div class="section-heading"><div><p class="eyebrow">Independent tools</p><h2 id="tools-title">Tools for research.</h2></div><a href="/work">All projects →</a></div><div class="real-tool-grid">{tools.map(t=><article class="real-tool-card"><a class:list={['real-tool-image',`tool-${t.id}`]} href={t.route}><img src={M.screenshots[t.id].image} alt={M.screenshots[t.id].alt} width="1280" height="720" loading="lazy"/></a><div><p class="meta">{t.role}</p><h3><a href={t.route}>{t.title}</a></h3><p>{t.text}</p><div class="source-links"><a href={t.route}>My contribution →</a><a href={M.screenshots[t.id].url}>{t.id==='notandia'?'Source & installation':'Try the directory'} ↗</a></div></div></article>)}</div></section>
 <section class="presence-section real-visuals" aria-labelledby="visual-title" data-enter><div class="section-heading"><div><p class="eyebrow">Data analysis &amp; visual communication</p><h2 id="visual-title">Charts, maps &amp; diagrams.</h2></div><a href="/work/scientific-visualizations">Full collection →</a></div><div class="artifact-tile-grid mobile-preview-strip" tabindex="0" role="region" aria-label="Published chart previews">{visuals.map(v=><a class="artifact-tile" href={v.url}><img src={v.image} alt={v.alt} width="800" height="600" loading="lazy"/><span>{v.caption} <span aria-hidden="true">↗</span></span></a>)}</div><p class="preview-scroll-hint">Scroll sideways to preview more charts.</p><p class="section-note">Published originals from Entropy, Tableau and Wikimedia Commons. More diagrams, data views and the Flourish collection are linked in the archive.</p></section>
 <section class="presence-section actual-atlas" aria-labelledby="atlas-title" data-enter><a class="atlas-screenshot" href={M.screenshots.atlas.url}><img src={M.screenshots.atlas.image} alt={M.screenshots.atlas.alt} width="1280" height="644" loading="lazy"/></a><div><p class="eyebrow">Accepted source-quality contributions</p><h2 id="atlas-title">AI Safety Formalization Atlas</h2><p>Five merged PRs covering source auditing, citation provenance and repository tooling. Listed coauthor of the September 2026 paper draft.</p><p class="review-quote">“Good work on improving sources!” <a href="https://github.com/mbrcic/ai-safety-formalization-atlas/pull/70#pullrequestreview-5334332149">— maintainer review of PR #70 ↗</a></p><a href="/work/atlas">Inspect my contributions →</a></div></section>
 <section class="presence-section background-section" aria-labelledby="background-title" data-enter><div class="background-copy"><p class="eyebrow">Experience &amp; education</p><h2 id="background-title">The wider background.</h2><a href="/experience">Full experience &amp; responsibilities →</a></div><div class="background-list">{P.experience.filter(e=>['/work/wikimedia','/research-operations'].includes(e.route)).map(e=><article><p class="meta">{e.period}</p><h3><a href={e.route}>{e.name}</a></h3><p>{e.text}</p></article>)}<article><p class="meta">Aug 2026–Present · Open UAS</p><h3>Metropolia University of Applied Sciences</h3><p>Non-degree IT path studies. Python Programming: 3 ECTS, Pass (September 2026). Continuing Python, SQL and quantitative foundations.</p></article><a class="investigation-link" href="/investigations">Read the source investigations →</a></div></section>
 <section class="presence-section experiments-section" aria-labelledby="experiment-title" data-enter><div class="section-heading"><div><p class="eyebrow">Further explorations</p><h2 id="experiment-title">Interactive experiments.</h2></div></div><div class="experiment-grid"><a class="experiment-card hyper-card" href="/work/hypermandala"><img src={M.screenshots.hypermandala.image} alt={M.screenshots.hypermandala.alt} width="1280" height="720" loading="lazy"/><div><p class="meta">Independent visualization experiment</p><h3>Hypermandala ↗</h3><p>Manipulate 2D, 3D and 4D geometry. This is a capture of the working explorer.</p></div></a><a class="experiment-card" href={M.screenshots.protein.url}><img src={M.screenshots.protein.image} alt={M.screenshots.protein.alt} width="1280" height="720" loading="lazy"/><div><p class="meta">Independent data project</p><h3>Protein / kg explorer ↗</h3><p>Explore national protein supply relative to estimated bodyweight. Sources and model assumptions stay visible.</p></div></a></div><div class="supporting-links"><a href="/ai-evaluation">Original AI-evaluation record ↗</a><a href="/work/telegram">Telegram &amp; cloud automation ↗</a><a href="/work">More projects &amp; contributions →</a></div></section>
 <section class="presence-section contact-panel" id="contact" aria-labelledby="contact-title" data-enter><div><p class="eyebrow">International opportunities</p><h2 id="contact-title">Discuss a role or project.</h2><p>{P.contact}</p><a class="contact-email" href={`mailto:${P.email}`}>{P.email} ↗</a></div><div class="contact-aside"><p>Research operations<br/>Source &amp; data quality<br/>Technical support &amp; implementation</p><p class="meta">{P.availability}</p><a href="/cv">View application résumés →</a></div></section>
</main><SiteFooter/></Layout>
<script>
if('IntersectionObserver' in window&&!matchMedia('(prefers-reduced-motion: reduce)').matches){const observer=new IntersectionObserver(entries=>{for(const entry of entries)if(entry.isIntersecting){entry.target.classList.add('entered');observer.unobserve(entry.target);}}, {threshold:.08});document.querySelectorAll('[data-enter]').forEach(el=>observer.observe(el));}
</script>
